# Dùng chung Supabase với dự án ai-tin-cong-nghe
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Không bắt buộc: báo khách mới qua Telegram (dùng chung bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Số Zalo nhận tin khách (để trống thì ẩn nút Zalo)
SO_ZALO=
EMAIL_LIEN_HE=
# Địa chỉ web sau khi đưa lên Vercel, ví dụ https://cong-nghe-24h-media.vercel.app
DIA_CHI_WEB=
# --- Quản lý Fanpage (đăng nhập Facebook) ---
# Lấy ở developers.facebook.com > App của bạn > Cài đặt > Cơ bản
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Chuỗi tự đặt, điền giống hệt ở mục Webhooks của app
FB_VERIFY_TOKEN=
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie đăng nhập (vd: openssl rand -base64 48)
SESSION_SECRET=
# Không bắt buộc, mặc định v23.0
FB_GRAPH_VERSION=
